{
  "name": "medichain-blockchain",
  "version": "1.0.0",
  "description": "MediChain+ — Solidity/Hardhat blockchain layer for insurance reimbursement and drug traceability.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node api/server.cjs",
    "compile": "hardhat compile",
    "test": "mocha --require tsx \"test/**/*.test.ts\"",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "fabric:wallet": "node scripts/importFabricIdentity.cjs",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "lint": "solhint \"contracts/**/*.sol\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.11",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.8",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.8.5",
    "@openzeppelin/contracts": "^5.0.2",
    "chai": "^6.2.2",
    "hardhat": "^3.4.5",
    "mocha": "^11.0.0",
    "solhint": "^5.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@hyperledger/fabric-gateway": "^1.11.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "express": "^4.22.1"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  }
}
