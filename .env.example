# -----------------------------------------------------------------------------
# MediChain+ - Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------------

# Deployer wallet private key (no 0x prefix required).
# Generate a fresh key for testnet/mainnet deployments.
PRIVATE_KEY=

# JSON-RPC endpoint for the target network.
# Polygon Amoy testnet example: https://rpc-amoy.polygon.technology
# Alchemy example:              https://polygon-amoy.g.alchemy.com/v2/<API_KEY>
RPC_URL=

# Polygon mainnet RPC (used for the "polygon" network in hardhat.config.ts).
POLYGON_RPC_URL=

# Polygonscan API key - required for contract verification.
# Obtain at https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=

# CoinMarketCap API key - optional, used for USD gas reporting.
COINMARKETCAP_API_KEY=

# Set to "true" to enable gas usage reports after each test run.
REPORT_GAS=false

# API Gateway (Node.js 20.9+)
API_PORT=3001
API_HOST=127.0.0.1
API_RPC_URL=http://127.0.0.1:8545
API_SIGNER_PRIVATE_KEY=
API_SIGNER_INDEX=0
JWT_SECRET=
JWT_ISSUER=medichain-api
JWT_AUDIENCE=medichain-frontend
JWT_EXPIRES_IN_SECONDS=3600
API_DEMO_ALLOW_ALL_ROLES=true
# Production authorization: set API_DEMO_ALLOW_ALL_ROLES=false and configure either API_PRINCIPALS
# or role-specific address allowlists. API_PRINCIPALS maps wallet addresses to roles and actor IDs.
# Example:
# API_PRINCIPALS={"0x1111111111111111111111111111111111111111":{"roles":["patient"],"patientId":"PAT-001"},"0x2222222222222222222222222222222222222222":{"roles":["doctor"],"doctorId":"DOC-007"}}
API_ADMIN_ADDRESSES=
API_PATIENT_ADDRESSES=
API_DOCTOR_ADDRESSES=
API_PHARMACY_ADDRESSES=
API_INSURER_ADDRESSES=
API_DEMO_PATIENT_ID=*
API_DEMO_DOCTOR_ID=*
API_DEMO_PHARMACY_ID=*
API_DEMO_INSURER_ID=*
API_JSON_LIMIT=5mb
API_MAX_BASE64_BYTES=5242880
API_IPFS_TIMEOUT_MS=15000
API_EVENT_BLOCK_LIMIT=5000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
REIMBURSEMENT_CONTRACT_ADDRESS=
DRUG_TRACEABILITY_CONTRACT_ADDRESS=

# Fabric / IPFS (Anas)
FABRIC_MODE=mock
FABRIC_CONNECTION_PROFILE=./fabric-anas/network/connection-org1.json
FABRIC_SAMPLES_PATH=
FABRIC_WALLET_PATH=./wallet/org1
FABRIC_IDENTITY=appUser
FABRIC_IMPORT_USER=User1@org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=medichannel
FABRIC_DISCOVERY_ENABLED=true
FABRIC_DISCOVERY_AS_LOCALHOST=true
FABRIC_CC_PATIENT_REGISTRY=patient-registry
FABRIC_CC_MEDICAL_RECORD=medical-record
FABRIC_CC_PRESCRIPTION=prescription
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs
FABRIC_MOCK_STORE=./data/fabric-mock.local.json
